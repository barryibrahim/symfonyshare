{% extends 'base.html.twig' %}

{% block title %}Liste des fichiers
{% endblock %}

{% block body %}
	<div class="container-fluid">
		<h1 class="text-center text-primary mt-4 pt-4 display-1 fw-bold">Liste des fichiers</h1>
		<div class="row justify-content-center">
			<div class="col-12 col-md-8 bg-white p-4 m-0 text-primary">
				<div class="table-responsive">

					<div class="container mt-5">
						<table class="table table-striped">
							<thead>
								<tr>
									<th>Nom du fichier</th>
									<th>Nom du serveur</th>
									<th>Extension</th>
									<th>Taille</th>
									<th>Date d'envoi</th>
									<th>Utilisateur</th>
								</tr>
							</thead>
							<tbody>
								{% for f in fichiers %}
									<tr>
										<td>{{ f.nomOriginal }}</td>
										<td>{{ f.nomServeur }}</td>
										<td>{{ f.extension }}</td>
										<td>{{ f.taille }}</td>
										<td>{{ f.dateEnvoi|date('Y-m-d H:i:s') }}</td>
										<td>{{ f.user.nom }}
											{{ f.user.prenom }}</td>
									</tr>
								{% endfor %}
							</tbody>
						</table>
					</div>
				{% endblock %}
