{% extends 'base.html.twig' %}

{% block title %}
    {{ parent() }} Statistique des utilisateurs
{% endblock %}

{% block body %}
<div class="container-fluid">
    <h1 class="text-center text-primary mt-4 pt-4 display-1 fw-bold">
       Statistique des utilisateurs
    </h1>
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 bg-white p-4 m-0 text-primary">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr class="fw-bold text-primary">
                            <th scope="col">Type d'utilisateur</th>
                            <th scope="col">Nombre</th>
                        </tr>
                    </thead>
                    <tbody>
                       <tr class="fw-bold text-primary">
                            <th scope="col">Total des Utilisateurs</th>
                            <th scope="col">{{ total }}</th>
                        </tr>
                         <tr class="fw-bold text-primary">
                            <th scope="col">Utilisateurs Actifs</th>
                            <th scope="col">{{ active }}</th>
                        </tr>
                         <tr class="fw-bold text-primary">
                            <th scope="col">Utilisateurs Désactivés</th>
                            <th scope="col">{{ disabled }}</th>
                        </tr>
                         <tr class="fw-bold text-primary">
                            <th scope="col">Administrateurs</th>
                            <th scope="col">{{ admins }}</th>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}

